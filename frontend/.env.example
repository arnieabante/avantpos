# Laravel API origin (no trailing slash). Must be the same origin as backend APP_URL,
# because e-mail verification links are signed for it.
#   local:      http://localhost:8000
#   production: https://api.avantpos.ph
VITE_API_URL=http://localhost:8000

# Base domain for tenant subdomains (shown on the registration form).
VITE_BASE_DOMAIN=avantpos.ph
