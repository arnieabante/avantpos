APP_NAME=AvantPOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=avantpos
DB_USERNAME=avantpos
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: true (cookies over HTTPS only). See docs/DEPLOYMENT.md for the full production .env.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@avantpos.ph"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- AvantPOS ---------------------------------------------------------------
# React SPA URL (used in e-mail links). Production: https://app.avantpos.ph
FRONTEND_URL=http://localhost:5173
# Tenants may use {subdomain}.AVANTPOS_BASE_DOMAIN
AVANTPOS_BASE_DOMAIN=avantpos.ph
AVANTPOS_APP_HOST=app.avantpos.ph
AVANTPOS_TRIAL_PLAN=professional
AVANTPOS_TRIAL_DAYS=14
# Uploaded images (logos, product photos): public locally (php artisan storage:link), s3 in production
AVANTPOS_MEDIA_DISK=public

# Sanctum SPA cookie auth: hosts that receive session cookies.
# Production: app.avantpos.ph,*.avantpos.ph   (and SESSION_DOMAIN=.avantpos.ph)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
# CORS (credentials) — production patterns example: #^https://[a-z0-9-]+\.avantpos\.ph$#
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGIN_PATTERNS=

# First platform super admin (required in production; random password printed locally if empty)
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
# Password for local demo accounts (DemoTenantSeeder, local only)
DEMO_PASSWORD=Password123

# SaaS billing (AvantPOS -> businesses). Gateway: manual, xendit or paymongo
BILLING_GATEWAY=manual
BILLING_VAT_REGISTERED=true
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
